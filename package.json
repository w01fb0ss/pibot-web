    "sync:theme": "node scripts/sync-theme.mjs ../PiBot",
    "deploy": "node scripts/build.mjs && wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "^4.151.2"
  }
}
