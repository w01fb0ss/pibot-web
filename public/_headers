/*
  Content-Security-Policy: default-src 'self'; img-src 'self'; media-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Content-Security-Policy: default-src 'self'; img-src 'self'; media-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/extension/firefox/*.xpi
  Content-Type: application/x-xpinstall
/extension/firefox/updates.json
  Cache-Control: no-cache

# Versioned copies of the root CSS/JS (scripts/version-assets.mjs): a new deploy uses a new folder.
/v/*
  Cache-Control: public, max-age=31536000, immutable

# Images and media rarely change; a replaced file with the same name may show for up to a day.
/assets/*
  Cache-Control: public, max-age=86400
