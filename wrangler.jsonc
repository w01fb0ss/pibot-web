{
  "name": "pibot",
  "compatibility_date": "2026-10-19",
  "main": "./worker/index.js",
  "send_metrics": false,
  "observability": { "enabled": false },
  // Gmail OAuth is intentionally a separate host so browser consent URLs are distinguishable
  // from the public site; DNS/custom-domain setup is a deployment prerequisite.
  "routes": [{ "pattern": "pibot.space", "custom_domain": true }, { "pattern": "auth.pibot.space", "custom_domain": true }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/", "/index.html", "/cn", "/en", "/guides", "/guides/*", "/download", "/download/*", "/about", "/about/*", "/releases", "/releases/*", "/privacy", "/privacy/*", "/terms", "/terms/*", "/updates/*", "/gmail/*", "/downloads/*", "/download-click/*", "/_stats", "/api/download-stats"] },
  // Aggregate update checks and download clicks by day, version and platform, without identifiers.
  "durable_objects": { "bindings": [
    { "name": "COUNTER", "class_name": "Counter" },
    { "name": "GMAIL_AUTH", "class_name": "GmailAuth" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Counter"] }, { "tag": "v2", "new_sqlite_classes": ["GmailAuth"] }],
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "pibot-releases" }]
}
